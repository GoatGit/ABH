{
  "name": "@abh/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./agent": {
      "types": "./dist/src/agent/checkpoint.d.ts",
      "import": "./dist/src/agent/checkpoint.js"
    },
    "./diagnostics": {
      "types": "./dist/src/diagnostics.d.ts",
      "import": "./dist/src/diagnostics.js"
    },
    "./pack": {
      "types": "./dist/src/pack-cli.d.ts",
      "import": "./dist/src/pack-cli.js"
    },
    "./server": {
      "types": "./dist/src/server/index.d.ts",
      "import": "./dist/src/server/index.js"
    },
    "./evaluation": {
      "types": "./dist/src/mission/evaluation-dispatcher.d.ts",
      "import": "./dist/src/mission/evaluation-dispatcher.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc -p tsconfig.client.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "migrate": "node scripts/migrate.mjs",
    "api:check": "node scripts/check-api.mjs",
    "api:update": "pnpm build && node scripts/check-api.mjs --update"
  },
  "dependencies": {
    "@abh/adapter-fastify": "workspace:*",
    "@abh/contracts": "workspace:*",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "postgres": "3.4.9",
    "semver": "7.7.4",
    "tar-stream": "3.2.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@abh/adapter-pg-boss": "workspace:*",
    "@microsoft/api-extractor": "7.59.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.10.1",
    "@types/semver": "7.7.1",
    "esbuild": "0.28.2",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.9.3"
  }
}
