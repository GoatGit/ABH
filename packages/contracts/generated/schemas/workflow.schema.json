              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/CapabilityRef"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Compiler"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        "connectorRefs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:abh:contracts:0.1.0:public#/$defs/CapabilityRef"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "Connector"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "x-abh-set": true
        },
        "scopeProofRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        },
        "completionPolicyRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        },
        "impactUpperBound": {
          "$ref": "#/$defs/ImpactUpperBound"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationPlanNode"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "x-abh-set": true
        },
        "digest": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Digest"
        }
      },
      "required": [
        "planRef",
        "actionRef",
        "planVersion",
        "pinSetRef",
        "pinSetDigest",
        "validatedAgainstPayloadDigest",
        "compilerRef",
        "connectorRefs",
        "scopeProofRef",
        "completionPolicyRef",
        "impactUpperBound",
        "nodes",
        "digest"
      ],
      "additionalProperties": false,
      "x-abh-digest-fields": [
        "actionRef",
        "planVersion",
        "pinSetRef",
        "pinSetDigest",
        "validatedAgainstPayloadDigest",
        "compilerRef",
        "connectorRefs",
        "scopeProofRef",
        "completionPolicyRef",
        "impactUpperBound",
        "nodes"
      ],
      "title": "OperationPlan"
    },
