        "nodeKey",
        "connectionRef",
        "accountRef",
        "resourceKey",
        "operationType",
        "payloadRef",
        "payloadDigest",
        "connectorRef",
        "scopeRefs",
        "completionPolicyRef",
        "resourceRequirements",
        "dependsOn",
        "inputBindings"
      ],
      "additionalProperties": false,
      "title": "OperationPlanNode"
    },
    "OperationPlan": {
      "type": "object",
      "properties": {
        "planRef": {
          "$ref": "#/$defs/PlanRef"
        },
        "actionRef": {
          "$ref": "#/$defs/ActionRef"
