      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[!-~]+$",
      "title": "IdempotencyKey"
    },
    "NodeKey": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
      "title": "NodeKey"
    },
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "title": "Reason"
    },
    "NonnegativeDecimal": {
      "allOf": [
        {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Decimal"
        },
        {
          "type": "string",
          "pattern": "^[0-9]"
        }
      ],
      "title": "NonnegativeDecimal"
    },
    "ResourceRequirement": {
      "type": "object",
      "properties": {
        "resourceRef": {
          "type": "object",
          "properties": {
            "type": {
              "const": "abh.resource"
            },
            "id": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
            },
            "version": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
            }
