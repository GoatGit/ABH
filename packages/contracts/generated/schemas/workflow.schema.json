      "properties": {
        "scopeRefs": {
          "type": "array",
          "items": {
            "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "x-abh-set": true
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRequirement"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "x-abh-set": true
        },
        "maxMoney": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": {
                "$ref": "#/$defs/NonnegativeDecimal"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
