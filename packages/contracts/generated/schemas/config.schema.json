{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abh:contracts:0.1.0:config",
  "$defs": {
    "ResolvedDevelopmentConfig": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "object",
          "properties": {
            "profile": {
              "const": "Development",
              "type": "string",
              "default": "Development",
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "Explicit development profile; production capabilities are unavailable.",
                "example": "Development"
              }
            }
          },
          "required": [
            "profile"
          ],
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "Fake",
              "type": "string",
              "default": "Fake",
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "Test identity provider, usable only with Development.",
                "example": "Fake"
              }
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "database": {
          "type": "object",
          "properties": {
            "runtimeUrlRef": {
              "type": "string",
              "pattern": "^env:ABH_[A-Z0-9_]+$",
              "maxLength": 200,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Reference",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/28-Data-Artifact与Audit详细设计.md",
                "description": "Explicit environment reference for the restricted business runtime database role.",
                "example": "env:ABH_DATABASE_RUNTIME_URL"
              }
            },
            "queueUrlRef": {
              "type": "string",
              "pattern": "^env:ABH_[A-Z0-9_]+$",
              "maxLength": 200,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Reference",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/28-Data-Artifact与Audit详细设计.md",
                "description": "Separate environment reference for the queue database role.",
                "example": "env:ABH_DATABASE_QUEUE_URL"
              }
            },
            "statementTimeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 30000,
              "default": 5000,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/28-Data-Artifact与Audit详细设计.md",
                "description": "Maximum database statement time, capped by the remaining request deadline.",
                "example": 5000
              }
            },
            "lockTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 1000,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/28-Data-Artifact与Audit详细设计.md",
                "description": "Maximum database lock wait; cannot exceed the statement timeout.",
                "example": 1000
              }
            }
          },
          "required": [
            "runtimeUrlRef",
            "queueUrlRef",
            "statementTimeoutMs",
            "lockTimeoutMs"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "businessEntry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "Local business declaration entry; this contract does not load or execute it.",
                "example": "./business.ts"
              }
            },
            "mode": {
              "const": "ActionOnly",
              "type": "string",
              "default": "ActionOnly",
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "Action-only dependencies; Agent, model and learning runtimes stay disabled.",
                "example": "ActionOnly"
              }
            },
            "action": {
              "type": "object",
              "properties": {
                "maxOperations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 100,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/25-Action-Engine详细设计.md",
                    "description": "Maximum operations fixed when an Action is validated.",
                    "example": 100
                  }
                },
                "maxDependencies": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32,
                  "default": 32,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/25-Action-Engine详细设计.md",
                    "description": "Maximum dependencies per node in the first Action profile.",
                    "example": 32
                  }
                },
                "intentExpirySeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400,
                  "default": 86400,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/25-Action-Engine详细设计.md",
                    "description": "Maximum lifetime of a proposed Action intent; shorter domain expiry still applies.",
                    "example": 86400
                  }
                }
              },
              "required": [
                "maxOperations",
                "maxDependencies",
                "intentExpirySeconds"
              ],
              "additionalProperties": false
            },
            "queue": {
              "type": "object",
              "properties": {
                "publishBatch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 100,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/27-Durable-Execution详细设计.md",
                    "description": "Bounded Outbox publication batch size.",
                    "example": 100
                  }
                },
                "pollIntervalMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 5000,
                  "default": 500,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/27-Durable-Execution详细设计.md",
                    "description": "Interval for Outbox polling in milliseconds.",
                    "example": 500
                  }
                }
              },
              "required": [
                "publishBatch",
                "pollIntervalMs"
              ],
              "additionalProperties": false
            },
            "reconciliation": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300,
                  "default": 5,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/26-Operation与Reconciliation详细设计.md",
                    "description": "Initial delay before observing an uncertain Operation.",
                    "example": 5
                  }
                },
                "maxDelaySeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300,
                  "default": 300,
                  "x-abh-config": {
                    "version": "0.1.0",
                    "profiles": [
                      "Development"
                    ],
                    "sensitivity": "Public",
                    "apply": "Restart",
                    "source": "docs/V1/10-ABH详细设计/26-Operation与Reconciliation详细设计.md",
                    "description": "Upper bound on reconciliation backoff; not a finality or expiry rule.",
                    "example": 300
                  }
                }
              },
              "required": [
                "initialDelaySeconds",
                "maxDelaySeconds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "businessEntry",
            "mode",
            "action",
            "queue",
            "reconciliation"
          ],
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "properties": {
            "enabled": {
              "const": false,
              "type": "boolean",
              "default": false,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "Workbench remains disabled until its implementation is available.",
                "example": false
              }
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        "observability": {
          "type": "object",
          "properties": {
            "projectTelemetry": {
              "type": "boolean",
              "const": false,
              "default": false,
              "x-abh-config": {
                "version": "0.1.0",
                "profiles": [
                  "Development"
                ],
                "sensitivity": "Public",
                "apply": "Restart",
                "source": "docs/V1/10-ABH详细设计/61-CLI-Distribution与运维详细设计.md",
                "description": "No project telemetry is enabled in this profile.",
                "example": false
              }
            }
          },
          "required": [
            "projectTelemetry"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "deployment",
        "identity",
        "database",
        "runtime",
        "web",
        "observability"
      ],
      "additionalProperties": false,
      "title": "ResolvedDevelopmentConfig"
    }
  }
}
