{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abh:contracts:0.1.0:adapters",
  "$defs": {
    "RequestContextRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.request-context"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "RequestContextRef"
    },
    "AuthorizedContextRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.authorized-context"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "AuthorizedContextRef"
    },
    "CredentialRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.credential"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "CredentialRef"
    },
    "JobRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.job"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "JobRef"
    },
    "WaitRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.durable-wait"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "WaitRef"
    },
    "StoredObjectRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "abh.stored-object"
        },
        "id": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "version": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        }
      },
      "required": [
        "type",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "title": "StoredObjectRef"
    },
    "PortCallContext": {
      "type": "object",
      "properties": {
        "callId": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "requestContextRef": {
          "$ref": "#/$defs/RequestContextRef"
        },
        "target": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Target"
        },
        "deadline": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        }
      },
      "required": [
        "callId",
        "requestContextRef",
        "target",
        "deadline"
      ],
      "additionalProperties": false,
      "title": "PortCallContext"
    },
    "IdentityVerifyRequest": {
      "type": "object",
      "properties": {
        "callId": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
        },
        "credentialRef": {
          "$ref": "#/$defs/CredentialRef"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "deadline": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        }
      },
      "required": [
        "callId",
        "credentialRef",
        "issuer",
        "audience",
        "deadline"
      ],
      "additionalProperties": false,
      "title": "IdentityVerifyRequest"
    },
    "VerifiedIdentity": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identityKind": {
          "enum": [
            "Human",
            "Service"
          ]
        },
        "authnStrength": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/AuthenticationStrength"
        },
        "credentialEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiedAt": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        },
        "expiresAt": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        },
        "evidenceRef": {
          "type": "object",
          "properties": {
            "type": {
              "const": "abh.identity-evidence"
            },
            "id": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
            },
            "version": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
            }
          },
          "required": [
            "type",
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "issuer",
        "subject",
        "audience",
        "identityKind",
        "authnStrength",
        "credentialEpoch",
        "verifiedAt",
        "expiresAt",
        "evidenceRef"
      ],
      "additionalProperties": false,
      "title": "VerifiedIdentity"
    },
    "EnqueueJobRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "job": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/JobEnvelope"
        }
      },
      "required": [
        "context",
        "job"
      ],
      "additionalProperties": false,
      "title": "EnqueueJobRequest"
    },
    "EnqueuedJob": {
      "type": "object",
      "properties": {
        "jobRef": {
          "$ref": "#/$defs/JobRef"
        }
      },
      "required": [
        "jobRef"
      ],
      "additionalProperties": false,
      "title": "EnqueuedJob"
    },
    "ScheduleWakeupRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "ownerRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        },
        "waitKey": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/IdempotencyKey"
        },
        "dueAt": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        },
        "causeRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        }
      },
      "required": [
        "context",
        "ownerRef",
        "waitKey",
        "dueAt",
        "causeRef"
      ],
      "additionalProperties": false,
      "title": "ScheduleWakeupRequest"
    },
    "ScheduledWakeup": {
      "type": "object",
      "properties": {
        "waitRef": {
          "$ref": "#/$defs/WaitRef"
        }
      },
      "required": [
        "waitRef"
      ],
      "additionalProperties": false,
      "title": "ScheduledWakeup"
    },
    "CancelWakeupRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "waitRef": {
          "$ref": "#/$defs/WaitRef"
        },
        "expectedVersion": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
        },
        "reason": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/Reason"
        }
      },
      "required": [
        "context",
        "waitRef",
        "expectedVersion",
        "reason"
      ],
      "additionalProperties": false,
      "title": "CancelWakeupRequest"
    },
    "CancelledWakeup": {
      "type": "object",
      "properties": {
        "waitRef": {
          "$ref": "#/$defs/WaitRef"
        },
        "disposition": {
          "enum": [
            "Prevented",
            "AlreadyClaimed",
            "AlreadyTerminal"
          ]
        },
        "receiptRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        }
      },
      "required": [
        "waitRef",
        "disposition",
        "receiptRef"
      ],
      "additionalProperties": false,
      "title": "CancelledWakeup"
    },
    "SignalWaitRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "ownerRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        },
        "committedEventRef": {
          "type": "object",
          "properties": {
            "type": {
              "const": "abh.event"
            },
            "id": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
            },
            "version": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
            }
          },
          "required": [
            "type",
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "waitKey": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/IdempotencyKey"
        }
      },
      "required": [
        "context",
        "ownerRef",
        "committedEventRef",
        "waitKey"
      ],
      "additionalProperties": false,
      "title": "SignalWaitRequest"
    },
    "SignalledWait": {
      "type": "object",
      "properties": {
        "waitRef": {
          "$ref": "#/$defs/WaitRef"
        },
        "wakeupRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        }
      },
      "required": [
        "waitRef",
        "wakeupRef"
      ],
      "additionalProperties": false,
      "title": "SignalledWait"
    },
    "InspectDeliveryRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "subjectRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/JobRef"
            },
            {
              "$ref": "#/$defs/WaitRef"
            }
          ]
        }
      },
      "required": [
        "context",
        "subjectRef"
      ],
      "additionalProperties": false,
      "title": "InspectDeliveryRequest"
    },
    "DeliveryInspection": {
      "type": "object",
      "properties": {
        "subjectRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/JobRef"
            },
            {
              "$ref": "#/$defs/WaitRef"
            }
          ]
        },
        "queueAgeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deliveryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastErrorCategory": {
          "enum": [
            "Validation",
            "Authentication",
            "Authorization",
            "NotFound",
            "Conflict",
            "Precondition",
            "Capacity",
            "Dependency",
            "Internal"
          ]
        },
        "ownerResultRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        }
      },
      "required": [
        "subjectRef",
        "queueAgeMs",
        "deliveryCount"
      ],
      "additionalProperties": false,
      "title": "DeliveryInspection"
    },
    "DrainQueueRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "queueClasses": {
          "type": "array",
          "items": {
            "enum": [
              "control",
              "reconcile",
              "interactive",
              "background"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "x-abh-set": true
        }
      },
      "required": [
        "context",
        "queueClasses"
      ],
      "additionalProperties": false,
      "title": "DrainQueueRequest"
    },
    "DrainReport": {
      "type": "object",
      "properties": {
        "drained": {
          "type": "boolean"
        },
        "remainingRefs": {
          "type": "array",
          "items": {
            "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true,
          "x-abh-set": true
        },
        "completedAt": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Time"
        }
      },
      "required": [
        "drained",
        "remainingRefs",
        "completedAt"
      ],
      "additionalProperties": false,
      "title": "DrainReport"
    },
    "ObjectDescriptor": {
      "type": "object",
      "properties": {
        "objectRef": {
          "$ref": "#/$defs/StoredObjectRef"
        },
        "digest": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "maxLength": 128
        }
      },
      "required": [
        "objectRef",
        "digest",
        "sizeBytes",
        "mediaType"
      ],
      "additionalProperties": false,
      "title": "ObjectDescriptor"
    },
    "PutObjectRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "authorizedContextRef": {
          "$ref": "#/$defs/AuthorizedContextRef"
        },
        "stagedArtifactRef": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/ArtifactRef"
        },
        "digest": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 104857600
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "maxLength": 128
        },
        "idempotencyKey": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/IdempotencyKey"
        }
      },
      "required": [
        "context",
        "authorizedContextRef",
        "stagedArtifactRef",
        "digest",
        "sizeBytes",
        "mediaType",
        "idempotencyKey"
      ],
      "additionalProperties": false,
      "title": "PutObjectRequest"
    },
    "ReadObjectRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "authorizedContextRef": {
          "$ref": "#/$defs/AuthorizedContextRef"
        },
        "objectRef": {
          "$ref": "#/$defs/StoredObjectRef"
        },
        "range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endInclusive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "endInclusive"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "context",
        "authorizedContextRef",
        "objectRef"
      ],
      "additionalProperties": false,
      "title": "ReadObjectRequest"
    },
    "ReadObjectDescriptor": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/$defs/ObjectDescriptor"
        },
        "range": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endInclusive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "endInclusive"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "object"
      ],
      "additionalProperties": false,
      "title": "ReadObjectDescriptor"
    },
    "StatObjectRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "authorizedContextRef": {
          "$ref": "#/$defs/AuthorizedContextRef"
        },
        "objectRef": {
          "$ref": "#/$defs/StoredObjectRef"
        }
      },
      "required": [
        "context",
        "authorizedContextRef",
        "objectRef"
      ],
      "additionalProperties": false,
      "title": "StatObjectRequest"
    },
    "DeleteObjectRequest": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/PortCallContext"
        },
        "authorizedContextRef": {
          "$ref": "#/$defs/AuthorizedContextRef"
        },
        "objectRef": {
          "$ref": "#/$defs/StoredObjectRef"
        },
        "deletionProofRef": {
          "type": "object",
          "properties": {
            "type": {
              "const": "abh.deletion-proof"
            },
            "id": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/UUID"
            },
            "version": {
              "$ref": "urn:abh:contracts:0.1.0:public#/$defs/Version"
            }
          },
          "required": [
            "type",
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "idempotencyKey": {
          "$ref": "urn:abh:contracts:0.1.0:workflow#/$defs/IdempotencyKey"
        }
      },
      "required": [
        "context",
        "authorizedContextRef",
        "objectRef",
        "deletionProofRef",
        "idempotencyKey"
      ],
      "additionalProperties": false,
      "title": "DeleteObjectRequest"
    },
    "DeletedObject": {
      "type": "object",
      "properties": {
        "objectRef": {
          "$ref": "#/$defs/StoredObjectRef"
        },
        "receiptRef": {
          "$ref": "urn:abh:contracts:0.1.0:public#/$defs/EntityRef"
        }
      },
      "required": [
        "objectRef",
        "receiptRef"
      ],
      "additionalProperties": false,
      "title": "DeletedObject"
    }
  }
}
